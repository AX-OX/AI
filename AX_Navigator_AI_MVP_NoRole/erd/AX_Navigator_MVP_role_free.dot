"users" -> "ai_tasks" [tooltip="user_id -> user_id"];
"ai_tasks" -> "ax_assessments" [tooltip="task_id -> task_id"];
"companies" -> "ax_assessments" [tooltip="company_id -> company_id"];
"users" -> "ax_roadmaps" [tooltip="approved_by -> user_id"];
"ax_assessments" -> "ax_roadmaps" [tooltip="assessment_id -> assessment_id"];
"ai_tasks" -> "ax_roadmaps" [tooltip="task_id -> task_id"];
"companies" -> "ax_roadmaps" [tooltip="company_id -> company_id"];
"ai_solution_catalog" -> "roadmap_items" [tooltip="solution_id -> solution_id"];
"business_processes" -> "roadmap_items" [tooltip="process_id -> process_id"];
"ax_roadmaps" -> "roadmap_items" [tooltip="roadmap_id -> roadmap_id"];
"departments" -> "ax_projects" [tooltip="owner_department_id -> department_id"];
"roadmap_items" -> "ax_projects" [tooltip="item_id -> item_id"];
}