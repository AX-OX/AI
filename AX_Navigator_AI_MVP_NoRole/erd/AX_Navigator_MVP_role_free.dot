digraph AX {
graph [rankdir=LR, bgcolor="white", pad="0.3", nodesep="0.34", ranksep="0.8", splines=polyline];
node [shape=plain, fontname="DejaVu Sans"];
edge [color="#8a99ae", arrowsize=0.60, penwidth=1.2];
"companies" [label=<<TABLE BORDER="1" COLOR="#c6d1df" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD ALIGN="LEFT" BGCOLOR="#31415f"><FONT COLOR="white"><B>companies</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eff3fa"><FONT POINT-SIZE="10">PK company_id : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">company_name : TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">industry : TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">employee_count : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">ax_budget_krw : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">created_at : TEXT</FONT></TD></TR></TABLE>>];
"departments" [label=<<TABLE BORDER="1" COLOR="#c6d1df" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD ALIGN="LEFT" BGCOLOR="#31415f"><FONT COLOR="white"><B>departments</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eff3fa"><FONT POINT-SIZE="10">PK department_id : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eff3fa"><FONT POINT-SIZE="10">FK company_id : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">department_name : TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">manager_name : TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">manager_email : TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">manager_phone : TEXT</FONT></TD></TR></TABLE>>];
"business_processes" [label=<<TABLE BORDER="1" COLOR="#c6d1df" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD ALIGN="LEFT" BGCOLOR="#31415f"><FONT COLOR="white"><B>business_processes</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eff3fa"><FONT POINT-SIZE="10">PK process_id : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eff3fa"><FONT POINT-SIZE="10">FK department_id : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">process_name : TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">purpose : TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">process_steps : TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">standardization_level : REAL</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">requires_approval : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">exception_rules : TEXT</FONT></TD></TR></TABLE>>];
"process_metrics" [label=<<TABLE BORDER="1" COLOR="#c6d1df" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD ALIGN="LEFT" BGCOLOR="#31415f"><FONT COLOR="white"><B>process_metrics</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eff3fa"><FONT POINT-SIZE="10">PK metric_id : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eff3fa"><FONT POINT-SIZE="10">FK process_id : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">period_start : TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">period_end : TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">processing_count : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">avg_processing_minutes : REAL</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">error_rate : REAL</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">hourly_labor_cost_krw : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">data_source : TEXT</FONT></TD></TR></TABLE>>];
"it_systems" [label=<<TABLE BORDER="1" COLOR="#c6d1df" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD ALIGN="LEFT" BGCOLOR="#31415f"><FONT COLOR="white"><B>it_systems</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eff3fa"><FONT POINT-SIZE="10">PK system_id : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eff3fa"><FONT POINT-SIZE="10">FK company_id : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">system_name : TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">system_type : TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">api_available : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">data_access_level : TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">cloud_based : INTEGER</FONT></TD></TR></TABLE>>];
"process_systems" [label=<<TABLE BORDER="1" COLOR="#c6d1df" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD ALIGN="LEFT" BGCOLOR="#31415f"><FONT COLOR="white"><B>process_systems</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eff3fa"><FONT POINT-SIZE="10">PK process_id : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eff3fa"><FONT POINT-SIZE="10">PK system_id : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">usage_purpose : TEXT</FONT></TD></TR></TABLE>>];
"documents" [label=<<TABLE BORDER="1" COLOR="#c6d1df" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD ALIGN="LEFT" BGCOLOR="#31415f"><FONT COLOR="white"><B>documents</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eff3fa"><FONT POINT-SIZE="10">PK document_id : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eff3fa"><FONT POINT-SIZE="10">FK company_id : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eff3fa"><FONT POINT-SIZE="10">FK process_id : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">title : TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">doc_type : TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">file_uri : TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">access_level : TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">version : TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">created_at : TEXT</FONT></TD></TR></TABLE>>];
"ai_solution_catalog" [label=<<TABLE BORDER="1" COLOR="#c6d1df" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD ALIGN="LEFT" BGCOLOR="#31415f"><FONT COLOR="white"><B>ai_solution_catalog</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eff3fa"><FONT POINT-SIZE="10">PK solution_id : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">solution_type : TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">solution_name : TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">description : TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">base_build_cost_krw : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">monthly_run_cost_krw : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">automation_rate_low : REAL</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">automation_rate_base : REAL</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">automation_rate_high : REAL</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">time_reduction_rate_low : REAL</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">time_reduction_rate_base : REAL</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">time_reduction_rate_high : REAL</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">min_standardization_level : REAL</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">requires_api : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">data_source : TEXT</FONT></TD></TR></TABLE>>];
"users" [label=<<TABLE BORDER="1" COLOR="#c6d1df" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD ALIGN="LEFT" BGCOLOR="#31415f"><FONT COLOR="white"><B>users</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eff3fa"><FONT POINT-SIZE="10">PK user_id : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eff3fa"><FONT POINT-SIZE="10">FK company_id : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">email : TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">password_hash : TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">user_name : TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">created_at : TEXT</FONT></TD></TR></TABLE>>];
"ai_tasks" [label=<<TABLE BORDER="1" COLOR="#c6d1df" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD ALIGN="LEFT" BGCOLOR="#31415f"><FONT COLOR="white"><B>ai_tasks</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eff3fa"><FONT POINT-SIZE="10">PK task_id : TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eff3fa"><FONT POINT-SIZE="10">FK user_id : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eff3fa"><FONT POINT-SIZE="10">FK company_id : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">request_text : TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">status : TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">result : TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">error_message : TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">trace_url : TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">created_at : TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">updated_at : TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">completed_at : TEXT</FONT></TD></TR></TABLE>>];
"ax_assessments" [label=<<TABLE BORDER="1" COLOR="#c6d1df" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD ALIGN="LEFT" BGCOLOR="#31415f"><FONT COLOR="white"><B>ax_assessments</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eff3fa"><FONT POINT-SIZE="10">PK assessment_id : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eff3fa"><FONT POINT-SIZE="10">FK company_id : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eff3fa"><FONT POINT-SIZE="10">FK task_id : TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">data_score : REAL</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">infra_score : REAL</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">automation_score : REAL</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">ai_capability_score : REAL</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">governance_score : REAL</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">total_score : REAL</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">criteria_version : TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">evidence : TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">created_at : TEXT</FONT></TD></TR></TABLE>>];
"ax_roadmaps" [label=<<TABLE BORDER="1" COLOR="#c6d1df" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD ALIGN="LEFT" BGCOLOR="#31415f"><FONT COLOR="white"><B>ax_roadmaps</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eff3fa"><FONT POINT-SIZE="10">PK roadmap_id : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eff3fa"><FONT POINT-SIZE="10">FK company_id : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eff3fa"><FONT POINT-SIZE="10">FK task_id : TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eff3fa"><FONT POINT-SIZE="10">FK assessment_id : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">roadmap_name : TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">budget_limit_krw : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">total_allocated_krw : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">approval_status : TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eff3fa"><FONT POINT-SIZE="10">FK approved_by : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">approved_at : TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">rejection_reason : TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">created_at : TEXT</FONT></TD></TR></TABLE>>];
"roadmap_items" [label=<<TABLE BORDER="1" COLOR="#c6d1df" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD ALIGN="LEFT" BGCOLOR="#31415f"><FONT COLOR="white"><B>roadmap_items</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eff3fa"><FONT POINT-SIZE="10">PK item_id : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eff3fa"><FONT POINT-SIZE="10">FK roadmap_id : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eff3fa"><FONT POINT-SIZE="10">FK process_id : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eff3fa"><FONT POINT-SIZE="10">FK solution_id : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">item_name : TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">priority_order : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">phase : TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">start_month : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">duration_months : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">allocated_budget_krw : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">expected_annual_saving_krw : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">roi_pct : REAL</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">payback_months : REAL</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">rationale : TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">evidence : TEXT</FONT></TD></TR></TABLE>>];
"ax_projects" [label=<<TABLE BORDER="1" COLOR="#c6d1df" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD ALIGN="LEFT" BGCOLOR="#31415f"><FONT COLOR="white"><B>ax_projects</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eff3fa"><FONT POINT-SIZE="10">PK project_id : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eff3fa"><FONT POINT-SIZE="10">FK item_id : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eff3fa"><FONT POINT-SIZE="10">FK owner_department_id : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">project_name : TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">project_status : TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">start_date : TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">end_date : TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">created_at : TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="10">updated_at : TEXT</FONT></TD></TR></TABLE>>];
"companies" -> "departments" [tooltip="company_id -> company_id"];
"departments" -> "business_processes" [tooltip="department_id -> department_id"];
"business_processes" -> "process_metrics" [tooltip="process_id -> process_id"];
