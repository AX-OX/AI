{
  "uid": "ax-agent-monitoring",
  "title": "AX Agent Monitoring",
  "schemaVersion": 41,
  "version": 1,
  "timezone": "browser",
  "editable": false,
  "refresh": "5s",
  "tags": [
    "ax-agent",
    "observability"
  ],
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Agent ready",
      "type": "stat",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "model-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min(up{job=\"ax-agent\"}) * (min(ax_agent_ready{job=\"ax-agent\"}) or vector(0))",
          "legendFormat": "",
          "instant": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "READY",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 2,
      "title": "Agent mode / configured model",
      "type": "stat",
      "description": "",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 12,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "model-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ax_agent_info{job=\"ax-agent\"}",
          "legendFormat": "mode={{mode}} / model={{model}} / LLM={{llm_enabled}}",
          "instant": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "name"
      }
    },
    {
      "id": 3,
      "title": "Active executions",
      "type": "stat",
      "description": "",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "model-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ax_agent_active_executions{job=\"ax-agent\"}",
          "legendFormat": "",
          "instant": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 4,
      "title": "Terminal success ratio (5m)",
      "type": "stat",
      "description": "DONE/(DONE+FAILED) execution segments. Approval pauses, rejected and cancelled excluded. No terminal runs = no data.",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "model-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(ax_agent_executions_total{job=\"ax-agent\",outcome=\"DONE\"}[5m])) / sum(increase(ax_agent_executions_total{job=\"ax-agent\",outcome=~\"DONE|FAILED\"}[5m]))",
          "legendFormat": "",
          "instant": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 5,
      "title": "Process resident memory",
      "type": "stat",
      "description": "",
      "gridPos": {
        "x": 6,
        "y": 5,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "model-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_resident_memory_bytes{job=\"ax-agent\"}",
          "legendFormat": "",
          "instant": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 6,
      "title": "Provider token totals",
      "type": "stat",
      "description": "Provider-reported usage only. Mock mode does not create tokens. No usage is shown as no data.",
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "model-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (model,kind) (ax_agent_llm_tokens_total{job=\"ax-agent\"})",
          "legendFormat": "{{model}} {{kind}}",
          "instant": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 7,
      "title": "HTTP requests / second",
      "type": "timeseries",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "model-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route,status) (rate(ax_agent_http_requests_total{job=\"ax-agent\"}[2m]))",
          "legendFormat": "{{route}} HTTP {{status}}",
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "title": "Execution outcomes",
      "type": "timeseries",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "model-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ax_agent_executions_total{job=\"ax-agent\"}",
          "legendFormat": "{{outcome}}",
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 9,
      "title": "LLM attempt p95",
      "type": "timeseries",
      "description": "Each retry counted separately; no LLM calls in mock mode.",
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "model-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by(le,stage) (rate(ax_agent_llm_duration_seconds_bucket{job=\"ax-agent\"}[2m])))",
          "legendFormat": "{{stage}}",
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 10,
      "title": "LLM attempts / second",
      "type": "timeseries",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 17,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "model-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(stage,outcome) (rate(ax_agent_llm_requests_total{job=\"ax-agent\"}[2m]))",
          "legendFormat": "{{stage}} {{outcome}}",
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 11,
      "title": "Tool calls / second",
      "type": "timeseries",
      "description": "Mock mode = fixture tool calls. Live mode = actual MCP calls. Logical call duration includes internal retries.",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "model-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(tool,outcome) (rate(ax_agent_tool_calls_total{job=\"ax-agent\"}[2m]))",
          "legendFormat": "{{tool}} {{outcome}}",
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 12,
      "title": "Tool latency p95",
      "type": "timeseries",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "model-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by(le,tool) (rate(ax_agent_tool_duration_seconds_bucket{job=\"ax-agent\"}[2m])))",
          "legendFormat": "{{tool}}",
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 13,
      "title": "Process CPU (100% = one core)",
      "type": "timeseries",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "model-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(process_cpu_seconds_total{job=\"ax-agent\"}[1m]) * 100",
          "legendFormat": "",
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 14,
      "title": "Execution segment p95",
      "type": "timeseries",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 31,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "model-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by(le) (rate(ax_agent_execution_duration_seconds_bucket{job=\"ax-agent\"}[2m])))",
          "legendFormat": "",
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 15,
      "type": "text",
      "title": "How to read this dashboard",
      "gridPos": {
        "x": 0,
        "y": 38,
        "w": 24,
        "h": 5
      },
      "options": {
        "mode": "markdown",
        "content": "**mode=mock**: the real AX Agent application executes with fixture tools; no OpenAI or pgvector network calls. **mode=llm-demo**: real LLM + fixture tools. **mode=live**: real LLM + MCP/pgvector. Token charts contain only provider-reported usage. No task IDs, prompts, document text, credentials, or user data are recorded as labels. CPU/RAM describe this process, not the host."
      }
    }
  ],
  "annotations": {
    "list": []
  },
  "links": [
