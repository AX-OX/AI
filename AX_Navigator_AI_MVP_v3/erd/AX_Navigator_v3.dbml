// Synthetic v3: business 14 + RAG 2; FK 27. See SQL for defaults, checks and identity semantics.
Table companies {
  company_id "BIGINT"
  company_name "VARCHAR(100)"
  industry "VARCHAR(50)"
  employee_count "INTEGER"
  ax_budget_krw "BIGINT"
  created_at "TIMESTAMP"
  indexes {
    (company_id) [pk]
  }
}
Table departments {
  department_id "BIGINT"
  company_id "BIGINT"
  department_name "VARCHAR(50)"
  manager_name "VARCHAR(50)"
  manager_email "VARCHAR(100)"
  manager_phone "VARCHAR(20)"
  indexes {
    (department_id) [pk]
  }
}
Table business_processes {
  process_id "BIGINT"
  department_id "BIGINT"
  process_name "VARCHAR(100)"
  purpose "TEXT"
  process_steps "JSONB"
  standardization_level "NUMERIC(3,2)"
  requires_approval "BOOLEAN"
  exception_rules "TEXT"
  indexes {
    (process_id) [pk]
  }
}
Table process_metrics {
  metric_id "BIGINT"
  process_id "BIGINT"
  period_start "DATE"
  period_end "DATE"
  processing_count "INTEGER"
  avg_processing_minutes "NUMERIC(8,2)"
  error_rate "NUMERIC(5,4)"
  hourly_labor_cost_krw "INTEGER"
  data_source "VARCHAR(20)"
  indexes {
    (metric_id) [pk]
  }
}
Table it_systems {
  system_id "BIGINT"
  company_id "BIGINT"
  system_name "VARCHAR(100)"
  system_type "VARCHAR(30)"
  api_available "BOOLEAN"
  data_access_level "VARCHAR(20)"
  cloud_based "BOOLEAN"
  indexes {
    (system_id) [pk]
  }
}
Table process_systems {
  process_id "BIGINT"
  system_id "BIGINT"
  usage_purpose "VARCHAR(200)"
  indexes {
    (process_id, system_id) [pk]
  }
}
Table documents {
  document_id "BIGINT"
  company_id "BIGINT"
  process_id "BIGINT"
  title "VARCHAR(200)"
  doc_type "VARCHAR(30)"
  file_uri "VARCHAR(500)"
  access_level "VARCHAR(20)"
  version "VARCHAR(20)"
  created_at "TIMESTAMP"
  indexes {
    (document_id) [pk]
  }
}
Table ai_solution_catalog {
  solution_id "BIGINT"
  target_process_id "BIGINT"
  depends_on_solution_id "BIGINT"
  solution_type "VARCHAR(30)"
  solution_name "VARCHAR(100)"
  description "TEXT"
  base_build_cost_krw "BIGINT"
  monthly_run_cost_krw "BIGINT"
  automation_rate_low "NUMERIC(3,2)"
  automation_rate_base "NUMERIC(3,2)"
  automation_rate_high "NUMERIC(3,2)"
  time_reduction_rate_low "NUMERIC(3,2)"
  time_reduction_rate_base "NUMERIC(3,2)"
  time_reduction_rate_high "NUMERIC(3,2)"
  min_standardization_level "NUMERIC(3,2)"
  requires_api "BOOLEAN"
  data_source "VARCHAR(20)"
  indexes {
    (solution_id) [pk]
  }
}
Table users {
  user_id "BIGINT"
  company_id "BIGINT"
  email "VARCHAR(100)"
  password_hash "VARCHAR(200)"
  user_name "VARCHAR(50)"
  created_at "TIMESTAMP"
  indexes {
    (user_id) [pk]
    email [unique]
  }
}
Table ai_tasks {
  task_id "VARCHAR(36)"
  user_id "BIGINT"
  company_id "BIGINT"
  request_text "TEXT"
  status "VARCHAR(30)"
  result "JSONB"
  error_message "TEXT"
  trace_url "VARCHAR(500)"
  created_at "TIMESTAMP"
  updated_at "TIMESTAMP"
  completed_at "TIMESTAMP"
  indexes {
    (task_id) [pk]
  }
}
Table ax_assessments {
  assessment_id "BIGINT"
  company_id "BIGINT"
  task_id "VARCHAR(36)"
  data_score "NUMERIC(5,2)"
  infra_score "NUMERIC(5,2)"
  automation_score "NUMERIC(5,2)"
  ai_capability_score "NUMERIC(5,2)"
  governance_score "NUMERIC(5,2)"
  total_score "NUMERIC(5,2)"
  criteria_version "VARCHAR(20)"
  evidence "JSONB"
  created_at "TIMESTAMP"
  indexes {
    (assessment_id) [pk]
  }
}
Table ax_roadmaps {
  roadmap_id "BIGINT"
  company_id "BIGINT"
  task_id "VARCHAR(36)"
  assessment_id "BIGINT"
  roadmap_name "VARCHAR(200)"
  budget_limit_krw "BIGINT"
  total_allocated_krw "BIGINT"
  approval_status "VARCHAR(20)"
  approved_by "BIGINT"
  approved_at "TIMESTAMP"
  rejection_reason "TEXT"
  created_at "TIMESTAMP"
  indexes {
    (roadmap_id) [pk]
  }
}
Table roadmap_items {
  item_id "BIGINT"
  roadmap_id "BIGINT"
  process_id "BIGINT"
  solution_id "BIGINT"
  item_name "VARCHAR(200)"
  priority_order "INTEGER"
  phase "VARCHAR(10)"
  start_month "INTEGER"
  duration_months "INTEGER"
  allocated_budget_krw "BIGINT"
  ax_score "NUMERIC(5,1)"
  impact_score "NUMERIC(5,1)"
  feasibility_score "NUMERIC(5,1)"
  expected_annual_saving_krw "BIGINT"
  roi_pct "NUMERIC(7,2)"
  payback_months "NUMERIC(5,1)"
  three_year_net_value_krw "BIGINT"
  rationale "TEXT"
  evidence "JSONB"
  indexes {
    (item_id) [pk]
  }
}
Table ax_projects {
  project_id "BIGINT"
  item_id "BIGINT"
  owner_department_id "BIGINT"
  project_name "VARCHAR(200)"
  project_status "VARCHAR(20)"
  start_date "DATE"
  end_date "DATE"
  created_at "TIMESTAMP"
  updated_at "TIMESTAMP"
  indexes {
    (project_id) [pk]
    item_id [unique]
  }
}
Table rag_indexes {
  company_id "BIGINT"
  index_version "TEXT"
  embedding_model "TEXT"
  embedding_revision "TEXT"
  corpus_hash "TEXT"
  chunk_count "INTEGER"
  indexed_at "TIMESTAMPTZ"
  indexes {
    (company_id, index_version) [pk]
  }
}
Table rag_document_chunks {
  company_id "BIGINT"
  index_version "TEXT"
  chunk_id "TEXT"
  document_id "BIGINT"
  title "TEXT"
  doc_type "TEXT"
  section "TEXT"
  page "INTEGER"
  chunk_index "INTEGER"
  related_process_ids "BIGINT[]"
  content "TEXT"
  metadata "JSONB"
  embedding "vector(384)"
  indexes {
    (company_id, index_version, chunk_id) [pk]
  }
}
Ref: departments.company_id > companies.company_id
Ref: business_processes.department_id > departments.department_id
Ref: process_metrics.process_id > business_processes.process_id
Ref: it_systems.company_id > companies.company_id
Ref: process_systems.process_id > business_processes.process_id
Ref: process_systems.system_id > it_systems.system_id
Ref: documents.company_id > companies.company_id
Ref: documents.process_id > business_processes.process_id
Ref: ai_solution_catalog.target_process_id > business_processes.process_id
Ref: ai_solution_catalog.depends_on_solution_id > ai_solution_catalog.solution_id
Ref: users.company_id > companies.company_id
Ref: ai_tasks.user_id > users.user_id
Ref: ai_tasks.company_id > companies.company_id
Ref: ax_assessments.company_id > companies.company_id
Ref: ax_assessments.task_id > ai_tasks.task_id
Ref: ax_roadmaps.company_id > companies.company_id
Ref: ax_roadmaps.task_id > ai_tasks.task_id
Ref: ax_roadmaps.assessment_id > ax_assessments.assessment_id
Ref: ax_roadmaps.approved_by > users.user_id
Ref: roadmap_items.roadmap_id > ax_roadmaps.roadmap_id
Ref: roadmap_items.process_id > business_processes.process_id
Ref: roadmap_items.solution_id > ai_solution_catalog.solution_id
Ref: ax_projects.item_id > roadmap_items.item_id
Ref: ax_projects.owner_department_id > departments.department_id
Ref: rag_indexes.company_id > companies.company_id
Ref: rag_document_chunks.(company_id, index_version) > rag_indexes.(company_id, index_version)
Ref: rag_document_chunks.document_id > documents.document_id
TableGroup business {
  companies
  departments
  business_processes
  process_metrics
  it_systems
  process_systems
  documents
  ai_solution_catalog
  users
  ai_tasks
  ax_assessments
  ax_roadmaps
  roadmap_items
  ax_projects
}
TableGroup rag_pgvector {
  rag_indexes
  rag_document_chunks
}
