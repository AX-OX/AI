POSTGRES_USER=ax
POSTGRES_PASSWORD=change-me-setup
RAG_READER_PASSWORD=change-me-reader
RAG_INDEXER_PASSWORD=change-me-indexer
INTERNAL_TOKEN=change-me
# Team Spring runs separately. Desktop Docker -> host Spring example:
SPRING_INTERNAL_URL=http://host.docker.internal:8080/internal

# mock = all fixtures; llm-demo = real OpenAI + tool fixtures; live = actual MCP/Spring/LLM
AGENT_MODE=live
# Independent reads per phase: 1 = sequential, default 3; valid range 1..8
AGENT_READ_CONCURRENCY=3
AGENT_DATABASE_URL=postgresql://ax:change-me-setup@postgres:5432/agent
OPENAI_API_KEY=
LLM_MODEL=
LLM_FALLBACK_MODEL=
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=

RAG_DATABASE_URL=postgresql://ax_rag_reader:change-me-reader@postgres:5432/ax
RAG_INDEX_DATABASE_URL=postgresql://ax_rag_indexer:change-me-indexer@postgres:5432/ax
RAG_INDEX_VERSION=ax-v3-openai-small-384-v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_REVISION=openai-dim384-v1
# Host processes only: defaults already point to v3. Containers use /app paths from Dockerfile.
# DATASET_DIR=/absolute/path/to/AX_Navigator_AI_MVP_v3
# AX_POLICY_FILE=/absolute/path/to/AX_Navigator_AI_MVP_v3/config/ax_score_policy_v1.json
# CORPUS_DIR=/absolute/path/to/AX_Navigator_AI_MVP_v3/rag

# Optional external references via official Tavily MCP; blank key skips search.
TAVILY_API_KEY=
TAVILY_ENABLED=true
TAVILY_TIMEOUT_SECONDS=12
# Durable worker: requires the matching BE recovery release and persistent checkpoints.
AGENT_WORKER_ENABLED=false
AGENT_WORKER_CONCURRENCY=1
AGENT_WORKER_POLL_SECONDS=2
AGENT_WORKER_DRAIN_SECONDS=30
